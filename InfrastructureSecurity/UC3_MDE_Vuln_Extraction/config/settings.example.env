# UC3 settings - copy this file to ".env" in the project root and edit it there.
# ".env" holds the Defender login secret: YOU type it here; never paste it in chat, e-mail or screenshots.

# ---- Microsoft Defender API ----------------------------------------------------
UC3_API_BASE=https://api.security.microsoft.com

# ---- Login details of the read-only app registration (Entra ID) --------------------
UC3_TENANT_ID=
UC3_CLIENT_ID=
# Lab default: client secret with a short expiry (30 days)
UC3_CLIENT_SECRET=
# Alternative (production best practice): certificate authentication
UC3_CERT_THUMBPRINT=
UC3_CERT_PATH=

# ---- Where data and logs go (relative paths are from the project root) ------------
UC3_DATA_DIR=./data
UC3_LOG_DIR=./logs

# ---- Optional: AI fix guide (python -m uc3 ai-fixes) ---------------------------------
# Azure AI Foundry (used when these three are set) or Google Gemini below.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=
# AI_PROVIDER=auto
# AZURE_FOUNDRY_RPM=60
# AZURE_FOUNDRY_REASONING_EFFORT=low
# Free Google Gemini key from https://aistudio.google.com/apikey (the UC1 key works too).
# Only app names, versions, CVE numbers, counts and Microsoft's CVE descriptions are sent - never device
# names, user names or secrets. Leave empty to show the fix cards without AI text.
GEMINI_API_KEY=
# Spare keys (optional): when a key uses up its daily quota, the next one takes over for the rest of the run.
# Each key must come from a different Google Cloud project; keys in the same project share one quota.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_RPM=10

# ---- Fix stage: the last stage of every run proposes the fixes that are new in this run ----------
# The Threat Intel Agent's fix engine pulls a fresh inventory, rebuilds its fix plan and lists the new fixes.
# Nothing is changed on a computer: a person presses Fix or Save for later on the portal's run page.
# UC3_FIX_STAGE=1
# UC3_FIX_ENGINE_DIR=../UC1_Threat_Intel_Hunting_Agent
