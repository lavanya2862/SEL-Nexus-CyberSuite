# UC4 settings. The real file is ".env" in the UC4 folder root. YOU type the Microsoft values; never paste them in
# chat, e-mail or screenshots. Empty = not set. `python -m uc4 check` shows which are set (never the values).

# ---- Microsoft (app registration UC4-Triage-Agent-Lab; permissions listed in the README) ----
UC4_TENANT_ID=
UC4_CLIENT_ID=
UC4_CLIENT_SECRET=

# ---- Google Gemini (copied from UC1 by scripts/copy_keys_from_uc1.py) ----
GEMINI_API_KEY=
# Spare keys (optional): when a key uses up its daily quota, the next one takes over for the rest of the run.
# Each key must come from a different Google Cloud project; keys in the same project share one quota.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_RPM=15
GEMINI_DAILY_CAP=1500

# ---- Threat intel (abuse.ch / OTX copied from UC1; AbuseIPDB / GreyNoise optional) ----
ABUSECH_AUTH_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=

# ---- Optional actions (OFF until your manager agrees) ----
UC4_WRITEBACK=0
UC4_CONTAIN=0
UC4_CLOSE=0
UC4_AUTO_RESOLVE=0
# response playbook: Defender scan / quarantine; automatic isolation off by default
UC4_RESPOND=0
UC4_AUTO_ISOLATE=0
UC4_SCAN_TYPE=Full
UC4_LAB_DEVICES=opca-wks-01,opcc-wks-01

# ---- Tuning (defaults shown) ----
UC4_LOOKBACK_DAYS=14
UC4_WINDOW_HOURS=24
UC4_MAX_QUERIES=12
UC4_MAX_ROWS=500
UC4_AI_ROWS=15
UC4_MAX_TI_LOOKUPS=20
