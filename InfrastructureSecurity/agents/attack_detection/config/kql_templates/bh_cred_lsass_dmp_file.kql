// name: Memory-dump file with "lsass" in its name written to disk
// kind: behaviour
// technique: T1003.001
// attack: 2
DeviceFileEvents
| where Timestamp > ago({{LOOKBACK}}d)
| where ActionType in ("FileCreated", "FileRenamed")
| where FileName has "lsass" and FileName matches regex @"(?i)\.(dmp|mdmp|bin|zip|out)$"
| where InitiatingProcessFileName !in~ ("WerFault.exe", "MsSense.exe")
| project Timestamp, DeviceId, DeviceName, ActionType, FileName, FolderPath, SHA256,
          InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine
| take 500
