// name: A new account's first sign-in, especially from another machine
// kind: behaviour
// technique: T1078
// attack: 8
let created = DeviceEvents
    | where Timestamp > ago({{LOOKBACK}}d)
    | where ActionType == "UserAccountCreated"
    | project DeviceId, AccountName = tolower(AccountName), CreatedAt = Timestamp;
DeviceLogonEvents
| where Timestamp > ago({{LOOKBACK}}d)
| where ActionType == "LogonSuccess"
| extend AccountKey = tolower(AccountName)
| join kind=inner (created | project DeviceId, AccountKey = AccountName, CreatedAt) on DeviceId, AccountKey
| where Timestamp >= CreatedAt
| summarize arg_min(Timestamp, *) by DeviceId, AccountKey
| project Timestamp, DeviceId, DeviceName, AccountName, CreatedAt, LogonType, RemoteIP, RemoteDeviceName,
          FromAnotherMachine = isnotempty(RemoteIP) and RemoteIPType != "Loopback"
| take 500
