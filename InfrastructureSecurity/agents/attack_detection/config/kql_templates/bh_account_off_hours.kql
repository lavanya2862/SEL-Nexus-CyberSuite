// name: Accounts created outside working hours
// kind: behaviour
// technique: T1136.001
// attack: 8
// Working hours are 07:00 to 19:00 UTC, Monday to Friday; change them here for another time zone.
let workStart = 7;
let workEnd = 19;
DeviceEvents
| where Timestamp > ago({{LOOKBACK}}d)
| where ActionType == "UserAccountCreated"
| extend Hour = hourofday(datetime_utc_to_local(Timestamp, "{{WORK_TZ}}")), Day = dayofweek(datetime_utc_to_local(Timestamp, "{{WORK_TZ}}")) / 1d
| where Hour < workStart or Hour >= workEnd or Day in (0, 6)
| project Timestamp, DeviceId, DeviceName, ActionType, AccountName, AccountDomain, Hour, Day,
          InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine
| take 500
