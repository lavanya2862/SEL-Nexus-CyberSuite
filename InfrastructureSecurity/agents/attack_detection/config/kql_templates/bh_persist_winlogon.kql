// name: Windows sign-in settings changed to start extra programs (Winlogon)
// kind: behaviour
// technique: T1547.004
// attack: 7
DeviceRegistryEvents
| where Timestamp > ago({{LOOKBACK}}d)
| where ActionType == "RegistryValueSet"
| where RegistryKey has @"\Microsoft\Windows NT\CurrentVersion\Winlogon"
| where RegistryValueName in~ ("Userinit", "Shell", "Notify", "Taskman", "AppSetup")
| where not(RegistryValueName =~ "Userinit" and RegistryValueData matches regex @"(?i)^c:\\windows\\system32\\userinit\.exe,?$")
| where not(RegistryValueName =~ "Shell" and RegistryValueData in~ ("explorer.exe", "explorer.exe,"))
| project Timestamp, DeviceId, DeviceName, ActionType, RegistryKey, RegistryValueName, RegistryValueData,
          InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine
| take 500
