# Copy to portal.env only if the defaults are wrong. No secrets live here.
# PORTAL_UC1_DIR=C:\Users\...\11. cyber\UC1_Threat_Intel_Hunting_Agent
# PORTAL_UC3_DIR=C:\Users\...\11. cyber\UC3_MDE_Vuln_Extraction
# PORTAL_PORT=8800

# ---- Sign-in
# PORTAL_AUTH=local                  # local = accounts kept by the portal (default), cognito = Amazon Cognito, off = no sign-in
# PORTAL_SIGNUP=on                   # off = nobody can create a new account (existing accounts still sign in)
# PORTAL_ALLOWED_EMAIL_DOMAINS=      # e.g. shv.nl,shv.com : only these email addresses may sign up / sign in
# PORTAL_SESSION_HOURS=12            # how long a sign-in lasts
# PORTAL_COOKIE_SECURE=off           # set on once the portal is reached over HTTPS (AWS load balancer)
# Amazon Cognito (only when PORTAL_AUTH=cognito; these are ids, not secrets):
# PORTAL_COGNITO_REGION=eu-west-1
# PORTAL_COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
# PORTAL_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional, in config/portal.secrets.env instead: PORTAL_SESSION_SECRET=<long random text> (default: data/auth/session.key)

# ---- Shared SEL Nexus CyberSuite sign-in page (../../login)
# PORTAL_LOGIN_URL=http://127.0.0.1:8000   # sign in and out there instead of on this portal
# PORTAL_AUTH_DIR=..\..\login\data\auth    # that page's accounts and session key (relative to this portal folder)
