    "metrics": { "type": "object" },
    "model": { "type": ["string", "null"] },
    "periods": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["days", "earlier", "funnel", "ioc_types", "ratings", "series", "sources", "start", "tactics", "threats_collected"],
