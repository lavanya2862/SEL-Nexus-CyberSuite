    "series": { "type": "object" },
    "tactics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tactic", "threats"],
        "properties": {
          "tactic": { "type": "string" },
          "threats": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "threats_collected": { "type": "number" },
    "top": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "chips",
          "devices",
          "first_seen",
          "hits",
          "id",
          "kind",
          "match",
          "published",
          "rating",
          "score",
          "source",
          "summary",
          "test",
          "title",
          "url",
          "why"
        ],
        "properties": {
          "action": { "type": "string" },
          "chips": { "type": "array", "items": { "type": "string" } },
          "devices": { "type": "string" },
          "first_seen": { "type": "string" },
          "hits": { "type": "number" },
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "match": { "type": "string" },
          "on_us": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["announced", "app", "cve", "device", "known", "match", "version"],
              "properties": {
                "announced": { "type": "string" },
                "app": { "type": "string" },
                "cve": { "type": "string" },
                "device": { "type": "string" },
                "known": { "type": "string" },
                "match": { "type": "string" },
                "version": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "published": { "type": "string" },
          "rating": { "type": "string" },
          "score": { "type": "number" },
          "source": { "type": "string" },
          "summary": { "type": "string" },
          "test": { "type": "boolean" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "why": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
