{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "threat_intel.dashboard_data.schema.json",
  "title": "Threat Intel Dashboard Data",
  "description": "Written by Threat Intel Agent (agents/threat_intel, data/dashboard/dashboard_data.json); read by dashboard (dashboard/src/dashboard/sources.py:ThreatIntelSource.dashboard)",
  "x-schema-version": 1,
  "type": "object",
  "required": [
