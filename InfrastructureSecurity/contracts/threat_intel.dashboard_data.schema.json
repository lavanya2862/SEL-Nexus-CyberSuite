          "days": { "type": "array", "items": { "type": "string" } },
          "earlier": { "type": "object" },
          "funnel": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["note", "stage", "value"],
              "properties": {
                "note": { "type": "string" },
                "stage": { "type": "string" },
                "value": { "type": "number" }
              }
            }
          },
          "ioc_types": { "type": "object" },
          "ratings": { "type": "object" },
          "series": { "type": "object" },
          "sources": { "type": "object" },
          "start": { "type": "string" },
          "tactics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["tactic", "threats"],
