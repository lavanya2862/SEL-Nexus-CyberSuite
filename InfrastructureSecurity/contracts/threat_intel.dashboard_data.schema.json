      "type": ["object", "null"],
      "properties": {
        "command": { "type": "string" },
        "finished_at": { "type": "string" },
        "run_id": { "type": "string" },
        "started_at": { "type": "string" },
        "status": { "type": "string" },
        "steps": { "type": "string" }
      }
