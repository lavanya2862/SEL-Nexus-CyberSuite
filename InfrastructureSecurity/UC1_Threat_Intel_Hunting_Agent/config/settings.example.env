# UC1 settings. The real file is ".env" in the UC1 folder root. YOU type the values; never paste them in chat,
# e-mail or screenshots. Empty = not set.

# ---- Microsoft Defender (read-only app registration UC1-Hunting-Agent-Lab) ----
DEFENDER_TENANT_ID=
DEFENDER_CLIENT_ID=
DEFENDER_CLIENT_SECRET=

# ---- AI: Azure AI Foundry (used instead of Gemini when these three are set) ----
# Foundry portal -> your project -> Models + endpoints -> your deployment: copy the endpoint (Target URI is fine),
# the key and the deployment name.
# Reasoning models (gpt-5, o-series): how hard they think - minimal | low | medium | high (off = not sent)
AZURE_FOUNDRY_REASONING_EFFORT=low
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=
# AI_PROVIDER: auto (Azure Foundry when set, else Gemini) | azure | gemini
AI_PROVIDER=auto
# requests per minute we allow ourselves; set it to your deployment's rate limit
AZURE_FOUNDRY_RPM=60
AZURE_FOUNDRY_DAILY_CAP=5000
AZURE_FOUNDRY_WORKERS=4

# ---- Google Gemini (fallback when Azure AI Foundry is not set) ----
GEMINI_API_KEY=
# Spare keys (optional): when a key uses up its daily quota, the next one takes over for the rest of the run.
# Each key must come from a different Google Cloud project; keys in the same project share one quota.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# requests per minute we allow ourselves. Free tier: about 15. Paid tier: raise it (e.g. 450 for a 500/min tier)
GEMINI_RPM=15
GEMINI_DAILY_CAP=5000
GEMINI_WORKERS=2

# ---- Threat feeds ----
NVD_API_KEY=
ABUSECH_AUTH_KEY=
OTX_API_KEY=

# ---- Optional: Teams alert (only with your organisation's approval) ----
TEAMS_WEBHOOK_URL=

# ---- Tuning (defaults shown) ----
KEV_BACKFILL_DAYS=30
NVD_BACKFILL_DAYS=3
FEED_BACKFILL_DAYS=7
HUNT_LOOKBACK_DAYS=30

# ---- Fix loop: UC1 updates/removes vulnerable apps on the LAB VMs after you approve ----
# Needs: role "Virtual Machine Contributor" on the resource group for UC1-Hunting-Agent-Lab (Run Command) and/or
# WindowsDefenderATP Machine.LiveResponse + Library.Manage (Live Response). Defaults shown.
AZURE_SUBSCRIPTION_ID=
FIX_RESOURCE_GROUP=rg-uc3-lab
FIX_METHOD=runcommand
# Chocolatey fallback when winget fails: off by default (it downloads and runs Chocolatey's installer as SYSTEM)
FIX_ALLOW_CHOCO=0
# Fix runs may switch a stopped lab VM on (the read-only check never does). Leave it on ~6 h so Defender can confirm.
FIX_START_VMS=1
# Limit fixing to some computers, e.g. FIX_DEVICES=opcc-wks-01 (the others are left alone and never marked fixed)
FIX_DEVICES=
