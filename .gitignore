# What is NOT pushed to GitHub. Each module can add its own .gitignore (InfrastructureSecurity/.gitignore does).

# ---- Passwords, keys and accounts (the sign-in page's accounts, session key and sign-in log)
login/data/
.env
*.env
.env.bak*
*.key
*.pem
*.pfx
*.cer
*.crt

# ---- Company data, databases and logs
data/
logs/
*.log
*.duckdb
*.parquet

# ---- Rebuilt on each computer
.venv/
node_modules/
dist/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# ---- Local tool and editor state
.claude/
.impeccable/

# ---- Drafts, decks and notes (only READMEs are kept)
*.md
!README.md
# ...and the guides every chat and person working on Infrastructure Security reads first
!InfrastructureSecurity/CLAUDE.md
!InfrastructureSecurity/docs/*.md
*.ppt
*.pptx
~$*

# ---- Data backups made by a restore
data.before-restore/
*.db
