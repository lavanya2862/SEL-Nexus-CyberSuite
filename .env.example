# SEL Nexus CyberSuite: the ONE settings file for every module (never commit the real .env).
# Shared keys (GEMINI_*, AZURE_FOUNDRY_*, ABUSECH_AUTH_KEY, OTX_API_KEY) appear once and apply to all.

# ======================================================================
# Shared sign-in page (login/)
# ======================================================================
# SEL Nexus CyberSuite sign-in page settings. No secrets live here.

LOGIN_PORT=8000

# ---- Where each module's button goes. Leave a URL empty to show that module as "Not connected yet".
INFRA_SEC_URL=http://127.0.0.1:8800
APP_SEC_URL=http://127.0.0.1:8500

# ---- Accounts
# LOGIN_SIGNUP=on                    # off = nobody can create a new account (existing accounts still sign in)
# LOGIN_ALLOWED_EMAIL_DOMAINS=       # e.g. shv.nl,shv.com : only these email addresses may sign up
# LOGIN_SESSION_HOURS=12             # how long a sign-in lasts
# LOGIN_COOKIE_SECURE=off            # set on once the suite is reached over HTTPS

# ======================================================================
# Infrastructure Security portal
# ======================================================================
# Copy to portal.env only if the defaults are wrong. No secrets live here.
# PORTAL_UC1_DIR=C:\Users\...\11. cyber\UC1_Threat_Intel_Hunting_Agent
# PORTAL_UC3_DIR=C:\Users\...\11. cyber\UC3_MDE_Vuln_Extraction
# PORTAL_PORT=8800

# ---- Sign-in
# PORTAL_AUTH=local                  # local = accounts kept by the portal (default), cognito = Amazon Cognito, off = no sign-in
# PORTAL_SIGNUP=on                   # off = nobody can create a new account (existing accounts still sign in)
# PORTAL_ALLOWED_EMAIL_DOMAINS=      # e.g. shv.nl,shv.com : only these email addresses may sign up / sign in
# PORTAL_SESSION_HOURS=12            # how long a sign-in lasts
# PORTAL_COOKIE_SECURE=off           # set on once the portal is reached over HTTPS (AWS load balancer)
# Amazon Cognito (only when PORTAL_AUTH=cognito; these are ids, not secrets):
# PORTAL_COGNITO_REGION=eu-west-1
# PORTAL_COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
# PORTAL_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional, in config/portal.secrets.env instead: PORTAL_SESSION_SECRET=<long random text> (default: data/auth/session.key)

# ---- Shared SEL Nexus CyberSuite sign-in page (../../login)
# PORTAL_LOGIN_URL=http://127.0.0.1:8000   # sign in and out there instead of on this portal
# PORTAL_AUTH_DIR=..\..\login\data\auth    # that page's accounts and session key (relative to this portal folder)

# ======================================================================
# Threat Intel Agent (UC1)
# ======================================================================
# UC1 settings. The real file is ".env" in the UC1 folder root. YOU type the values; never paste them in chat,
# e-mail or screenshots. Empty = not set.

# ---- Microsoft Defender (read-only app registration UC1-Hunting-Agent-Lab) ----
DEFENDER_TENANT_ID=
DEFENDER_CLIENT_ID=
DEFENDER_CLIENT_SECRET=

# ---- AI: Azure AI Foundry (used instead of Gemini when these three are set) ----
# Foundry portal -> your project -> Models + endpoints -> your deployment: copy the endpoint (Target URI is fine),
# the key and the deployment name.
# Reasoning models (gpt-5, o-series): how hard they think - minimal | low | medium | high (off = not sent)
AZURE_FOUNDRY_REASONING_EFFORT=low
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=
# AI_PROVIDER: auto (Azure Foundry when set, else Gemini) | azure | gemini
AI_PROVIDER=auto
# requests per minute we allow ourselves; set it to your deployment's rate limit
AZURE_FOUNDRY_RPM=60
AZURE_FOUNDRY_DAILY_CAP=5000
AZURE_FOUNDRY_WORKERS=4

# ---- Google Gemini (fallback when Azure AI Foundry is not set) ----
GEMINI_API_KEY=
# Spare keys (optional): when a key uses up its daily quota, the next one takes over for the rest of the run.
# Each key must come from a different Google Cloud project; keys in the same project share one quota.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# requests per minute we allow ourselves. Free tier: about 15. Paid tier: raise it (e.g. 450 for a 500/min tier)
GEMINI_RPM=15
GEMINI_DAILY_CAP=5000
GEMINI_WORKERS=2

# ---- Threat feeds ----
NVD_API_KEY=
ABUSECH_AUTH_KEY=
OTX_API_KEY=

# ---- Optional: Teams alert (only with your organisation's approval) ----
TEAMS_WEBHOOK_URL=

# ---- Tuning (defaults shown) ----
KEV_BACKFILL_DAYS=30
NVD_BACKFILL_DAYS=3
FEED_BACKFILL_DAYS=7
HUNT_LOOKBACK_DAYS=30

# ---- Fix loop: UC1 updates/removes vulnerable apps on the LAB VMs after you approve ----
# Needs: role "Virtual Machine Contributor" on the resource group for UC1-Hunting-Agent-Lab (Run Command) and/or
# WindowsDefenderATP Machine.LiveResponse + Library.Manage (Live Response). Defaults shown.
AZURE_SUBSCRIPTION_ID=
FIX_RESOURCE_GROUP=rg-uc3-lab
FIX_METHOD=runcommand
# Chocolatey fallback when winget fails: off by default (it downloads and runs Chocolatey's installer as SYSTEM)
FIX_ALLOW_CHOCO=0
# Fix runs may switch a stopped lab VM on (the read-only check never does). Leave it on ~6 h so Defender can confirm.
FIX_START_VMS=1
# Limit fixing to some computers, e.g. FIX_DEVICES=opcc-wks-01 (the others are left alone and never marked fixed)
FIX_DEVICES=

# ======================================================================
# Vulnerability Agent (UC3)
# ======================================================================
# UC3 settings - copy this file to ".env" in the project root and edit it there.
# ".env" holds the Defender login secret: YOU type it here; never paste it in chat, e-mail or screenshots.

# ---- Microsoft Defender API ----------------------------------------------------
UC3_API_BASE=https://api.security.microsoft.com

# ---- Login details of the read-only app registration (Entra ID) --------------------
UC3_TENANT_ID=
UC3_CLIENT_ID=
# Lab default: client secret with a short expiry (30 days)
UC3_CLIENT_SECRET=
# Alternative (production best practice): certificate authentication
UC3_CERT_THUMBPRINT=
UC3_CERT_PATH=

# ---- Where data and logs go (relative paths are from the project root) ------------
UC3_DATA_DIR=./data
UC3_LOG_DIR=./logs

# ---- Optional: AI fix guide (python -m uc3 ai-fixes) ---------------------------------
# Azure AI Foundry (used when these three are set) or Google Gemini below.
# Free Google Gemini key from https://aistudio.google.com/apikey (the UC1 key works too).
# Only app names, versions, CVE numbers, counts and Microsoft's CVE descriptions are sent - never device
# names, user names or secrets. Leave empty to show the fix cards without AI text.
# Spare keys (optional): when a key uses up its daily quota, the next one takes over for the rest of the run.
# Each key must come from a different Google Cloud project; keys in the same project share one quota.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# ---- Fix stage: the last stage of every run proposes the fixes that are new in this run ----------
# The Threat Intel Agent's fix engine pulls a fresh inventory, rebuilds its fix plan and lists the new fixes.
# Nothing is changed on a computer: a person presses Fix or Save for later on the portal's run page.
# UC3_FIX_STAGE=1
# UC3_FIX_ENGINE_DIR=../UC1_Threat_Intel_Hunting_Agent

# ======================================================================
# Alert Triage Agent (UC4)
# ======================================================================
# UC4 settings. The real file is ".env" in the UC4 folder root. YOU type the Microsoft values; never paste them in
# chat, e-mail or screenshots. Empty = not set. `python -m uc4 check` shows which are set (never the values).

# ---- Microsoft (app registration UC4-Triage-Agent-Lab; permissions listed in the README) ----
UC4_TENANT_ID=
UC4_CLIENT_ID=
UC4_CLIENT_SECRET=

# ---- AI: Azure AI Foundry (used instead of Gemini when these three are set) ----
# Foundry portal -> your project -> Models + endpoints -> your deployment: copy the endpoint (Target URI is fine),
# the key and the deployment name.
# Reasoning models (gpt-5, o-series): how hard they think - minimal | low | medium | high (off = not sent)
# AI_PROVIDER: auto (Azure Foundry when set, else Gemini) | azure | gemini
# requests per minute we allow ourselves; set it to your deployment's rate limit

# ---- Google Gemini, fallback when Azure AI Foundry is not set (copied from UC1 by scripts/copy_keys_from_uc1.py) ----
# Spare keys (optional): when a key uses up its daily quota, the next one takes over for the rest of the run.
# Each key must come from a different Google Cloud project; keys in the same project share one quota.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
UC4_GEMINI_DAILY_CAP=1500

# ---- Threat intel (abuse.ch / OTX copied from UC1; AbuseIPDB / GreyNoise optional) ----
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=

# ---- Optional actions (OFF until your manager agrees) ----
UC4_WRITEBACK=0
UC4_CONTAIN=0
UC4_CLOSE=0
UC4_AUTO_RESOLVE=0
# response playbook: Defender scan / quarantine; automatic isolation off by default
UC4_RESPOND=0
UC4_AUTO_ISOLATE=0
UC4_SCAN_TYPE=Full
UC4_LAB_DEVICES=opca-wks-01,opcc-wks-01

# ---- Tuning (defaults shown) ----
UC4_LOOKBACK_DAYS=14
UC4_WINDOW_HOURS=24
UC4_MAX_QUERIES=12
UC4_MAX_ROWS=500
UC4_AI_ROWS=15
UC4_MAX_TI_LOOKUPS=20

# ======================================================================
# Application Security (remediation pipeline)
# ======================================================================
# ---------------------------------------------------------------------------------------------
# Everything is optional: with no settings the service scans any public GitHub repo, applies
# deterministic fixes (dependency upgrades, safe rewrites) and produces reports + a patch.
# ---------------------------------------------------------------------------------------------

# --- LLM for code fixes (OpenAI-compatible endpoint or Anthropic) ---------------------------
# LLM_PROVIDER: auto | openai | anthropic | none   (auto picks anthropic for claude-* models)
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=4
LLM_MAX_CONCURRENCY=4
LLM_FIX_ATTEMPTS=2
MAX_FINDINGS_PER_RUN=15

# --- GitHub ---------------------------------------------------------------------------------
# Needed for private repositories and to push a branch / open pull requests (create_pr).
# Fine-grained token with Contents: read/write and Pull requests: read/write.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# Comma-separated hosts accepted as input (add a GitHub Enterprise host if needed).
ALLOWED_GIT_HOSTS=github.com

# --- Storage --------------------------------------------------------------------------------
DATA_DIR=./data
# Empty = SQLite in DATA_DIR (single node). For multiple API/worker nodes use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/remediation
DATABASE_URL=
KEEP_WORKSPACES=false

# --- Limits ---------------------------------------------------------------------------------
MAX_REPO_SIZE_MB=750
CLONE_TIMEOUT_SECONDS=600
SCANNER_TIMEOUT_SECONDS=1200
JOB_TIMEOUT_SECONDS=3600
MAX_QUEUED_JOBS=500
MAX_JOB_ATTEMPTS=2
RATE_LIMIT_PER_MINUTE=30
RESULT_CACHE_TTL_HOURS=24

# --- Workers --------------------------------------------------------------------------------
# true: the API process also runs workers (simple single-node setup).
EMBEDDED_WORKER=true
WORKER_CONCURRENCY=2
LEASE_SECONDS=180

# --- Scanners (each is used only if installed; OSV and builtin-* need nothing) --------------
ENABLE_TRIVY=true
ENABLE_SEMGREP=true
ENABLE_BANDIT=true
ENABLE_CODEQL=true
# Path to the codeql executable if it is not on PATH (scripts/install-codeql.* installs to tools/codeql).
CODEQL_PATH=
# CodeQL query suite: code-scanning (GitHub's default), security-extended (more security queries) or
# security-and-quality (also code-quality queries).
CODEQL_SUITE=security-extended
ENABLE_OSV=true
ENABLE_BUILTIN_SAST=true
ENABLE_BUILTIN_SECRETS=true
ENABLE_LOCKFILE_REFRESH=true
# Semgrep rule packs from semgrep.dev, comma separated: the curated default plus the OWASP Top 10 and CWE Top 25 packs.
SEMGREP_CONFIG=p/default,p/owasp-top-ten,p/cwe-top-25

# --- API ------------------------------------------------------------------------------------
# Comma-separated API keys. Empty = no authentication (trusted local use only).
API_KEYS=
CORS_ORIGINS=
LOG_LEVEL=INFO
LOG_JSON=false
ALLOW_WORKFLOW_EDITS=false

# --- Who sees which scans (shared sign-in on) ------------------------------------------------
# everyone: every signed-in person sees every scan; the Activity log page shows who started, re-ran or cancelled each
# scan, who approved its fixes and opened the pull request, and who ran the tests, with name, email, date and time.
# owner: each person sees only the scans they started (and only their own activity).
RUNS_VISIBLE_TO=everyone

# --- Each signed-in person's own keys -------------------------------------------------------
# With the shared sign-in on (Start_Application_Security.cmd sets SUITE_LOGIN_URL), every person sees only the scans
# they started and saves their own GitHub token and AI key under Settings; GITHUB_TOKEN and LLM_API_KEY above are then
# never used. Saved keys are encrypted with CREDENTIALS_KEY (a Fernet key: python -c "from cryptography.fernet import
# Fernet; print(Fernet.generate_key().decode())"), best injected by a secret store, or else with a key file made on
# first use at CREDENTIALS_KEY_FILE (the Start script uses ApplicationSecurity\secrets\credentials.key; the default is
# DATA_DIR/credentials.key, so keep it outside DATA_DIR in production). Losing the key means everyone enters their
# keys again.
CREDENTIALS_KEY=
# CREDENTIALS_KEY_FILE=
