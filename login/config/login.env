# SEL Nexus CyberSuite sign-in page settings. No secrets live here.

LOGIN_PORT=8000

# ---- Where each module's button goes. Leave a URL empty to show that module as "Not connected yet".
DEFENDER_INFRA_URL=http://127.0.0.1:8800
CODE_VULN_URL=

# ---- Accounts
# LOGIN_SIGNUP=on                    # off = nobody can create a new account (existing accounts still sign in)
# LOGIN_ALLOWED_EMAIL_DOMAINS=       # e.g. shv.nl,shv.com : only these email addresses may sign up
# LOGIN_SESSION_HOURS=12             # how long a sign-in lasts
# LOGIN_COOKIE_SECURE=off            # set on once the suite is reached over HTTPS
