# ---------------------------------------------------------------------------------------------
# Everything is optional: with no settings the service scans any public GitHub repo, applies
# deterministic fixes (dependency upgrades, safe rewrites) and produces reports + a patch.
# ---------------------------------------------------------------------------------------------

# --- LLM for code fixes (OpenAI-compatible endpoint or Anthropic) ---------------------------
# LLM_PROVIDER: auto | openai | anthropic | none   (auto picks anthropic for claude-* models)
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=4
LLM_MAX_CONCURRENCY=4
LLM_FIX_ATTEMPTS=2
MAX_FINDINGS_PER_RUN=15

# --- GitHub ---------------------------------------------------------------------------------
# Needed for private repositories and to push a branch / open pull requests (create_pr).
# Fine-grained token with Contents: read/write and Pull requests: read/write.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# Comma-separated hosts accepted as input (add a GitHub Enterprise host if needed).
ALLOWED_GIT_HOSTS=github.com

# --- Storage --------------------------------------------------------------------------------
DATA_DIR=./data
# Empty = SQLite in DATA_DIR (single node). For multiple API/worker nodes use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/remediation
DATABASE_URL=
KEEP_WORKSPACES=false

# --- Limits ---------------------------------------------------------------------------------
MAX_REPO_SIZE_MB=750
CLONE_TIMEOUT_SECONDS=600
SCANNER_TIMEOUT_SECONDS=1200
JOB_TIMEOUT_SECONDS=3600
MAX_QUEUED_JOBS=500
MAX_JOB_ATTEMPTS=2
RATE_LIMIT_PER_MINUTE=30
RESULT_CACHE_TTL_HOURS=24

# --- Workers --------------------------------------------------------------------------------
# true: the API process also runs workers (simple single-node setup).
EMBEDDED_WORKER=true
WORKER_CONCURRENCY=2
LEASE_SECONDS=180

# --- Scanners (each is used only if installed; OSV and builtin-* need nothing) --------------
ENABLE_TRIVY=true
ENABLE_SEMGREP=true
ENABLE_BANDIT=true
ENABLE_CODEQL=true
# Path to the codeql executable if it is not on PATH (scripts/install-codeql.* installs to tools/codeql).
CODEQL_PATH=
ENABLE_OSV=true
ENABLE_BUILTIN_SAST=true
ENABLE_BUILTIN_SECRETS=true
ENABLE_LOCKFILE_REFRESH=true
SEMGREP_CONFIG=p/default

# --- Running repository tests (executes untrusted code!) -----------------------------------
# disabled | docker | local   (local = on the host; only for repositories you trust)
SANDBOX_MODE=disabled
SANDBOX_NETWORK=none
SANDBOX_CPUS=2
SANDBOX_MEMORY=2g
TEST_TIMEOUT_SECONDS=900

# --- API ------------------------------------------------------------------------------------
# Comma-separated API keys. Empty = no authentication (trusted local use only).
API_KEYS=
CORS_ORIGINS=
LOG_LEVEL=INFO
LOG_JSON=false
ALLOW_WORKFLOW_EDITS=false
