// Q25 host_security_events (Sentinel): the lab VM's own Windows security log around the alert, counted per event
// type and account: logons (4624/4625), account and group changes (4720-4738), log cleared (1102).
SecurityEvent
| where TimeGenerated between (datetime({{START}}) .. datetime({{END}}))
| where tostring(split(Computer, ".")[0]) in~ ({{HOSTS}})
| where EventID in (4624, 4625, 4634, 4648, 4672, 4720, 4722, 4723, 4724, 4725, 4726, 4728, 4732, 4738, 4740, 1102)
| where EventID != 4624 or LogonType in (2, 3, 7, 10, 11)
| extend Who = iff(isnotempty(TargetUserName) and TargetUserName != "-", TargetUserName, SubjectUserName)
| where Who !endswith "$" and Who !in~ ("SYSTEM", "LOCAL SERVICE", "NETWORK SERVICE", "ANONYMOUS LOGON")
| summarize Events = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated),
            DoneBy = make_set(SubjectUserName, 3), SourceIps = make_set(IpAddress, 3), LogonTypes = make_set(LogonType, 4)
          by Computer, EventID, Activity, Who
| order by FirstSeen asc
| take {{LIMIT}}
